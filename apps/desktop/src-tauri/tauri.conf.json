{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PersonAIly Hub",
  "mainBinaryName": "PersonAIly Hub",
  "version": "0.1.0",
  "identifier": "dev.personaily.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PersonAIly Hub",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ThomasCaputo",
    "copyright": "Copyright 2026 ThomasCaputo",
    "homepage": "https://github.com/ThomasCaputo/personaily-hub",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Local and cloud AI models, chat and agents in one desktop app",
    "longDescription": "PersonAIly Hub brings cloud models (Anthropic, OpenAI-compatible services) and local GGUF models run through llama.cpp together in one app, with chat, autonomous agents, MCP tools, a local OpenAI-compatible API and a VS Code extension.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Italian"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "PersonAIly Hub"
      }
    }
  }
}
