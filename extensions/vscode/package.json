{
  "name": "personaily-hub-vscode",
  "displayName": "PersonAIly Hub",
  "description": "Chat e modifiche al codice con i modelli locali e cloud di PersonAIly Hub.",
  "version": "0.1.0",
  "publisher": "personaily",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "personailyHub",
          "title": "PersonAIly Hub",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "personailyHub": [
        {
          "type": "webview",
          "id": "personailyHub.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "personailyHub.edit",
        "title": "Chiedi una modifica…",
        "category": "PersonAIly Hub"
      },
      {
        "command": "personailyHub.chooseModel",
        "title": "Scegli il modello",
        "category": "PersonAIly Hub",
        "icon": "$(chip)"
      },
      {
        "command": "personailyHub.newChat",
        "title": "Nuova conversazione",
        "category": "PersonAIly Hub",
        "icon": "$(add)"
      },
      {
        "command": "personailyHub.history",
        "title": "Apri una conversazione",
        "category": "PersonAIly Hub",
        "icon": "$(history)"
      },
      {
        "command": "personailyHub.startAgent",
        "title": "Avvia un agente",
        "category": "PersonAIly Hub"
      },
      {
        "command": "personailyHub.acceptProposal",
        "title": "Accetta la modifica",
        "category": "PersonAIly Hub",
        "icon": "$(check)"
      },
      {
        "command": "personailyHub.rejectProposal",
        "title": "Rifiuta la modifica",
        "category": "PersonAIly Hub",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "personailyHub.newChat",
          "when": "view == personailyHub.chat",
          "group": "navigation@1"
        },
        {
          "command": "personailyHub.history",
          "when": "view == personailyHub.chat",
          "group": "navigation@2"
        },
        {
          "command": "personailyHub.chooseModel",
          "when": "view == personailyHub.chat",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "personailyHub.acceptProposal",
          "when": "resourceScheme == personaily-proposta",
          "group": "navigation@1"
        },
        {
          "command": "personailyHub.rejectProposal",
          "when": "resourceScheme == personaily-proposta",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "personailyHub.edit",
          "when": "editorTextFocus",
          "group": "1_modification@9"
        }
      ],
      "commandPalette": [
        {
          "command": "personailyHub.acceptProposal",
          "when": "resourceScheme == personaily-proposta"
        },
        {
          "command": "personailyHub.rejectProposal",
          "when": "resourceScheme == personaily-proposta"
        }
      ]
    },
    "keybindings": [
      {
        "command": "personailyHub.edit",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "PersonAIly Hub",
      "properties": {
        "personailyHub.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Percorso di `app-server.exe`, il nucleo senza interfaccia. Serve solo quando l'app desktop è chiusa: l'estensione lo avvia da sé."
        },
        "personailyHub.dataDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Cartella dati dell'app. Vuota: quella predefinita (`%APPDATA%\\dev.personaily.hub`)."
        },
        "personailyHub.maxContextChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "markdownDescription": "Caratteri massimi del file aperto inviati come contesto. Per i file più lunghi si invia solo la selezione."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "tsc -p . && node --test test/",
    "package": "tsc -p . && vsce package --no-dependencies --allow-missing-repository --skip-license -o personaily-hub.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "~6.0.3"
  }
}
