{
  "name": "personaily-hub-vscode",
  "displayName": "PersonAIly Hub",
  "description": "%description%",
  "version": "1.3.1",
  "publisher": "personaily",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThomasCaputo/personaily-hub"
  },
  "homepage": "https://github.com/ThomasCaputo/personaily-hub",
  "bugs": {
    "url": "https://github.com/ThomasCaputo/personaily-hub/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "personailyHub",
          "title": "PersonAIly Hub",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "personailyHub": [
        {
          "type": "webview",
          "id": "personailyHub.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "personailyHub.edit",
        "title": "%command.edit%",
        "category": "PersonAIly Hub"
      },
      {
        "command": "personailyHub.chooseModel",
        "title": "%command.chooseModel%",
        "category": "PersonAIly Hub",
        "icon": "$(chip)"
      },
      {
        "command": "personailyHub.newChat",
        "title": "%command.newChat%",
        "category": "PersonAIly Hub",
        "icon": "$(add)"
      },
      {
        "command": "personailyHub.history",
        "title": "%command.history%",
        "category": "PersonAIly Hub",
        "icon": "$(history)"
      },
      {
        "command": "personailyHub.startAgent",
        "title": "%command.startAgent%",
        "category": "PersonAIly Hub"
      },
      {
        "command": "personailyHub.sessions",
        "title": "%command.sessions%",
        "category": "PersonAIly Hub"
      },
      {
        "command": "personailyHub.acceptProposal",
        "title": "%command.acceptProposal%",
        "category": "PersonAIly Hub",
        "icon": "$(check)"
      },
      {
        "command": "personailyHub.rejectProposal",
        "title": "%command.rejectProposal%",
        "category": "PersonAIly Hub",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "personailyHub.newChat",
          "when": "view == personailyHub.chat",
          "group": "navigation@1"
        },
        {
          "command": "personailyHub.history",
          "when": "view == personailyHub.chat",
          "group": "navigation@2"
        },
        {
          "command": "personailyHub.chooseModel",
          "when": "view == personailyHub.chat",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "personailyHub.acceptProposal",
          "when": "resourceScheme == personaily-proposta",
          "group": "navigation@1"
        },
        {
          "command": "personailyHub.rejectProposal",
          "when": "resourceScheme == personaily-proposta",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "personailyHub.edit",
          "when": "editorTextFocus",
          "group": "1_modification@9"
        }
      ],
      "commandPalette": [
        {
          "command": "personailyHub.acceptProposal",
          "when": "resourceScheme == personaily-proposta"
        },
        {
          "command": "personailyHub.rejectProposal",
          "when": "resourceScheme == personaily-proposta"
        }
      ]
    },
    "keybindings": [
      {
        "command": "personailyHub.edit",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "PersonAIly Hub",
      "properties": {
        "personailyHub.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.serverPath%"
        },
        "personailyHub.dataDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.dataDir%"
        },
        "personailyHub.maxContextChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "markdownDescription": "%config.maxContextChars%"
        },
        "personailyHub.inlineCompletion": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.inlineCompletion%"
        },
        "personailyHub.inlineCompletionDelay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 3000,
          "markdownDescription": "%config.inlineCompletionDelay%"
        }
      }
    }
  },
  "scripts": {
    "sync": "node scripts/sync-core-texts.mjs",
    "build": "npm run sync && tsc -p .",
    "watch": "npm run sync && tsc -p . --watch",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "npm run sync && tsc -p . && node scripts/check-i18n.mjs && node --test test/",
    "package": "npm run sync && tsc -p . && node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\" && vsce package --no-dependencies -o personaily-hub.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "~6.0.3"
  }
}
