{
  "name": "personaily-hub",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "overrides": {
    "katex": "^0.19.1"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "npm run tauri -w desktop -- dev",
    "build": "npm run tauri -w desktop -- build",
    "build:ui": "npm run build -w desktop",
    "check": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && npm run check:i18n -w desktop"
  }
}
